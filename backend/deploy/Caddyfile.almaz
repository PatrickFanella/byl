{
	# Almaz / Cloudflare edge terminates public DNS; Caddy proxies to the NUC.
	# Set a real contact email before going live.
	email ops@example.com
}

museum-api.example.com {
	encode zstd gzip
	# Replace nuc.lan or 192.168.x.x with the NUC hostname/IP reachable from Almaz.
	reverse_proxy http://nuc.lan:8080
}

museum-media.example.com {
	encode zstd gzip
	# MinIO bucket with anonymous download enabled; see docs/deployment/nuc-almaz.md.
	reverse_proxy http://nuc.lan:9000
}

museum-admin.example.com {
	encode zstd gzip
	# Curator admin app (nginx serving the SvelteKit build; proxies /api to the API itself).
	reverse_proxy http://nuc.lan:3000
}
